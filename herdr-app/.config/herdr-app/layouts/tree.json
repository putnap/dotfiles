{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    -100,
    -100
  ],
  "background": "background",
  "terminal_padding": [
    10,
    6
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 280
      },
      "min": 42,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "sidebar-top"
          }
        },
        {
          "id": "tree",
          "type": "block",
          "content": {
            "mod": "tree"
          }
        },
        {
          "id": "keys",
          "type": "block",
          "size": {
            "px": 0
          },
          "content": {
            "mod": "keys"
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tab-bar"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 0,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 0,
                  "radius": 0,
                  "background": "background",
                  "lone": false,
                  "border": {
                    "width": 1,
                    "color": "border"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "weight": 1
              },
              "min": 280,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "reviewer"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "theme": "catppuccin-mocha",
  "font": "JetBrains Mono",
  "ui_font": "JetBrains Mono"
}

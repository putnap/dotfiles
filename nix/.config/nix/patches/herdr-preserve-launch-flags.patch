+impl AgentResumePlan {
+    /// Carry the flags a pane was originally launched with (`claude
+    /// --dangerously-skip-permissions`) onto the canonical resume command.
+    /// Flags the resume command already sets (and their values) are dropped
+    /// so `--resume <old>` cannot shadow `--resume <current>`.
+    pub fn with_saved_launch_argv(mut self, saved_argv: &[String]) -> Self {
+        let Some((program, saved_flags)) = saved_argv.split_first() else {
+            return self;
+        };
+        if self.argv.first() != Some(program) {
+            return self;
+        }
+        let plan_flags: Vec<&str> = self.argv[1..]
+            .iter()
+            .map(String::as_str)
+            .filter(|arg| arg.starts_with('-'))
+            .collect();
+        let mut extra = Vec::new();
+        let mut skip_value = false;
+        for arg in saved_flags {
+            let is_flag = arg.starts_with('-');
+            if skip_value && !is_flag {
+                skip_value = false;
+                continue;
+            }
+            skip_value = false;
+            let flag_name = arg.split_once('=').map_or(arg.as_str(), |(name, _)| name);
+            if is_flag && plan_flags.contains(&flag_name) {
+                skip_value = !arg.contains('=');
+                continue;
+            }
+            extra.push(arg.clone());
+        }
+        self.argv.extend(extra);
+        self
+    }
+}

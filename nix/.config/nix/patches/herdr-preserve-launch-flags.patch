+    #[test]
+    fn resume_plan_keeps_saved_launch_flags() {
+        let session = AgentSessionRef::id("claude-session").unwrap();
+        let plan = plan("herdr:claude", "claude", &session).unwrap();
+        let argv = |args: &[&str]| args.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+
+        assert_eq!(
+            plan.clone()
+                .with_saved_launch_argv(&argv(&["claude", "--dangerously-skip-permissions"]))
+                .argv,
+            vec![
+                "claude",
+                "--resume",
+                "claude-session",
+                "--dangerously-skip-permissions"
+            ]
+        );
+        assert_eq!(
+            plan.clone()
+                .with_saved_launch_argv(&argv(&[
+                    "claude",
+                    "--resume",
+                    "stale-session",
+                    "--permission-mode",
+                    "plan"
+                ]))
+                .argv,
+            vec![
+                "claude",
+                "--resume",
+                "claude-session",
+                "--permission-mode",
+                "plan"
+            ]
+        );
+        assert_eq!(
+            plan.clone()
+                .with_saved_launch_argv(&argv(&[
+                    "claude",
+                    "--resume=stale-session",
+                    "--model",
+                    "opus"
+                ]))
+                .argv,
+            vec!["claude", "--resume", "claude-session", "--model", "opus"]
+        );
+        assert_eq!(
+            plan.clone()
+                .with_saved_launch_argv(&argv(&["bash", "-lc", "claude"]))
+                .argv,
+            vec!["claude", "--resume", "claude-session"]
+        );
+        assert_eq!(plan.clone().with_saved_launch_argv(&[]).argv, plan.argv);
+    }
 }

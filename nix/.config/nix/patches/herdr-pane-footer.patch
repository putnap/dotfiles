+//! A presentation row outside the PTY viewport; values come from pane metadata.
+use super::text::{display_width, truncate_end};
+use crate::{
+    app::{state::Palette, AppState},
+    config::{FooterField, PaneFooterConfig},
+    layout::{PaneId, PaneInfo},
+    terminal::TerminalState,
+};
+use ratatui::{
+    layout::Rect,
+    style::{Color, Style},
+    text::{Line, Span},
+    widgets::Paragraph,
+    Frame,
+};
+
+fn terminal(app: &AppState, ws: usize, pane: PaneId) -> Option<&TerminalState> {
+    let id = app.workspaces.get(ws)?.terminal_id(pane)?;
+    app.terminals.get(id)
+}
+fn eligible(state: &TerminalState) -> bool {
+    let label = state.effective_agent_label().or_else(|| {
+        state
+            .pending_agent_resume_plan
+            .as_ref()
+            .map(|plan| plan.agent.as_str())
+    });
+    matches!(label, Some("claude" | "codex"))
+}
+pub(crate) fn reserve(area: Rect, enabled: bool) -> (Rect, Option<Rect>) {
+    if !enabled || area.height < 3 || area.width < 8 {
+        return (area, None);
+    }
+    (
+        Rect::new(area.x, area.y, area.width, area.height - 1),
+        Some(Rect::new(area.x, area.y + area.height - 1, area.width, 1)),
+    )
+}
+pub(crate) fn content_rect(app: &AppState, ws: usize, pane: PaneId, area: Rect) -> Rect {
+    let enabled = app.pane_footer.enabled && terminal(app, ws, pane).is_some_and(eligible);
+    reserve(area, enabled).0
+}
+fn access(
+    value: Option<&str>,
+    cfg: &PaneFooterConfig,
+    palette: &Palette,
+) -> Option<(String, Color)> {
+    let value = value?;
+    let color = if value == "[bypass]" {
+        cfg.critical_color
+    } else {
+        cfg.access_color
+    };
+    Some((value.to_owned(), color.resolve(palette)))
+}
+fn metric(
+    label: &str,
+    value: Option<&str>,
+    cfg: &PaneFooterConfig,
+    palette: &Palette,
+) -> Option<(String, Color)> {
+    let used = value
+        .and_then(|v| v.parse::<f64>().ok())
+        .filter(|v| v.is_finite() && *v >= 0.0);
+    match used {
+        Some(used) => {
+            let color = if used > f64::from(cfg.critical_percent) {
+                cfg.critical_color.resolve(palette)
+            } else if used > f64::from(cfg.warning_percent) {
+                cfg.warning_color.resolve(palette)
+            } else {
+                cfg.usage_color.resolve(palette)
+            };
+            Some((format!("{label} {:.0}%", used), color))
+        }
+        None => None,
+    }
+}
+struct Segment {
+    spans: Vec<Span<'static>>,
+    width: usize,
+    low_priority: bool,
+}
+fn render_item(
+    item: &crate::config::FooterItem,
+    part: &impl Fn(FooterField) -> Option<(String, Color)>,
+    literal_color: Color,
+) -> Option<Segment> {
+    use crate::config::{FooterAtom, FooterItem};
+    let mut spans = Vec::new();
+    let mut has_token = false;
+    let mut visible_token = false;
+    let mut only_model = true;
+    let mut token = |field| {
+        has_token = true;
+        only_model &= matches!(field, FooterField::Model | FooterField::Effort);
+        if let Some((text, color)) = part(field) {
+            visible_token = true;
+            Some(Span::styled(text, Style::default().fg(color)))
+        } else {
+            None
+        }
+    };
+    match item {
+        FooterItem::Token(field) => spans.extend(token(*field)),
+        FooterItem::Group(atoms) => {
+            for atom in atoms {
+                match atom {
+                    FooterAtom::Token(field) => spans.extend(token(*field)),
+                    FooterAtom::Literal(text) => spans.push(Span::styled(
+                        text.clone(),
+                        Style::default().fg(literal_color),
+                    )),
+                }
+            }
+        }
+    }
+    let width = spans.iter().map(|span| display_width(&span.content)).sum();
+    if (has_token && !visible_token) || width == 0 {
+        return None;
+    }
+    Some(Segment {
+        spans,
+        width,
+        low_priority: has_token && only_model,
+    })
+}
+fn parts_width(parts: &[Segment], separator: &str) -> usize {
+    parts.iter().map(|part| part.width).sum::<usize>()
+        + parts.len().saturating_sub(1) * display_width(separator)
+}
+fn parts_spans(
+    parts: &[Segment],
+    mut width: usize,
+    separator: &str,
+    separator_color: Color,
+) -> Vec<Span<'static>> {
+    let mut spans = Vec::new();
+    for (i, part) in parts.iter().enumerate() {
+        if i > 0 {
+            let size = display_width(separator);
+            if width <= size {
+                break;
+            }
+            spans.push(Span::styled(
+                separator.to_owned(),
+                Style::default().fg(separator_color),
+            ));
+            width -= size;
+        }
+        for span in &part.spans {
+            let text = truncate_end(&span.content, width);
+            width = width.saturating_sub(display_width(&text));
+            spans.push(Span::styled(text, span.style));
+            if width == 0 {
+                return spans;
+            }
+        }
+    }
+    spans
+}
+// Outer items (including entire groups) are indivisible on the right side.
+fn layout(
+    width: u16,
+    left: &[Segment],
+    right: &[Segment],
+    separator: &str,
+    separator_color: Color,
+) -> (Vec<Span<'static>>, Vec<Span<'static>>, u16) {
+    let available = usize::from(width.saturating_sub(2));
+    let mut count = right.len();
+    while count > 0 && parts_width(&right[..count], separator) > available {
+        count -= 1;
+    }
+    let right_width = parts_width(&right[..count], separator);
+    let left_width = available.saturating_sub(right_width + usize::from(right_width > 0) * 2);
+    (
+        parts_spans(left, left_width, separator, separator_color),
+        parts_spans(&right[..count], right_width, separator, separator_color),
+        right_width as u16,
+    )
+}
+pub(crate) fn render(app: &AppState, ws: usize, info: &PaneInfo, frame: &mut Frame) {
+    if !app.pane_footer.enabled {
+        return;
+    }
+    let Some(state) = terminal(app, ws, info.id).filter(|s| eligible(s)) else {
+        return;
+    };
+    let inner = super::panes::pane_inner_rect(info.rect, info.borders);
+    let Some(area) = reserve(inner, true).1 else {
+        return;
+    };
+    let tokens = &state.metadata_tokens;
+    // A stale collector must never paint the previous occupant's measurements.
+    let valid = (state.persisted_agent_session.is_none()
+        && state.effective_agent_label() == Some("codex")
+        && tokens.get("footer_terminal") == Some(state.id.as_str()))
+        || state
+            .persisted_agent_session
+            .as_ref()
+            .is_some_and(|session| {
+                Some(session.agent.as_str()) == state.effective_agent_label()
+                    && tokens.get("footer_session") == Some(session.session_ref.value.as_str())
+            });
+    let value = |key| if valid { tokens.get(key) } else { None };
+    let cfg = &app.pane_footer;
+    let fallback = state
+        .cwd
+        .file_name()
+        .and_then(|s| s.to_str())
+        .unwrap_or("/");
+    let part = |field: FooterField| -> Option<(String, Color)> {
+        let (text, color) = match field {
+            FooterField::Access => return access(value("footer_access"), cfg, &app.palette),
+            FooterField::Directory => {
+                (value("footer_dir").unwrap_or(fallback), cfg.directory_color)
+            }
+            FooterField::Branch => (value("footer_branch")?, cfg.branch_color),
+            FooterField::Model => (value("footer_model_name")?, cfg.model_color),
+            FooterField::Effort => (value("footer_effort")?, cfg.effort_color),
+            FooterField::Context => {
+                return metric(&cfg.context_label, value("footer_ctx"), cfg, &app.palette)
+            }
+            FooterField::FiveHour => {
+                return metric(&cfg.five_hour_label, value("footer_5h"), cfg, &app.palette)
+            }
+            FooterField::Weekly => {
+                return metric(&cfg.weekly_label, value("footer_week"), cfg, &app.palette)
+            }
+        };
+        (!text.is_empty()).then(|| (text.to_owned(), color.resolve(&app.palette)))
+    };
+    let separator_color = cfg.separator_color.resolve(&app.palette);
+    let collect = |items: &[crate::config::FooterItem]| -> Vec<Segment> {
+        items
+            .iter()
+            .filter_map(|item| render_item(item, &part, separator_color))
+            .collect()
+    };
+    let left = collect(&cfg.left);
+    let mut right = collect(&cfg.right);
+    if parts_width(&right, &cfg.separator) > usize::from(area.width.saturating_sub(2)) {
+        right.retain(|part| !part.low_priority);
+    }
+    let (left_spans, right, right_width) =
+        layout(area.width, &left, &right, &cfg.separator, separator_color);
+    let style = Style::default()
+        .bg(cfg.background_color.resolve(&app.palette))
+        .fg(app.palette.text);
+    frame.render_widget(Paragraph::new("").style(style), area);
+    let left_width = area.width.saturating_sub(right_width + 3);
+    frame.render_widget(
+        Paragraph::new(Line::from(left_spans)).style(style),
+        Rect::new(area.x + 1, area.y, left_width, 1),
+    );
+    if right_width > 0 {
+        frame.render_widget(
+            Paragraph::new(Line::from(right)).style(style),
+            Rect::new(area.right() - right_width - 1, area.y, right_width, 1),
+        );
+    }
+}

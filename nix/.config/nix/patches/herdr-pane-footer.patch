+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn pane_footer_reserves_exactly_one_row_and_preserves_tiny_terminals() {
+        let original = Rect::new(7, 9, 80, 24);
+        let (content, footer) = reserve(original, true);
+        assert_eq!(content, Rect::new(7, 9, 80, 23));
+        assert_eq!(footer, Some(Rect::new(7, 32, 80, 1)));
+        assert_eq!(reserve(original, false), (original, None));
+        for h in 0..3 {
+            let a = Rect::new(0, 0, 80, h);
+            assert_eq!(reserve(a, true), (a, None));
+        }
+    }
+    #[test]
+    fn pane_footer_narrow_unicode_layout_never_overlaps() {
+        let cfg: PaneFooterConfig =
+            toml::from_str("left=['directory','branch']\nright=[['model',' ','effort'],'context']")
+                .unwrap();
+        let values = |field| {
+            Some((
+                match field {
+                    FooterField::Model => "astra",
+                    FooterField::Effort => "high",
+                    FooterField::Context => "ctx 12%",
+                    FooterField::Directory => "工作树",
+                    _ => "feature/login",
+                }
+                .into(),
+                if field == FooterField::Effort {
+                    Color::Blue
+                } else {
+                    Color::Green
+                },
+            ))
+        };
+        let collect = |items: &[crate::config::FooterItem]| {
+            items
+                .iter()
+                .filter_map(|item| render_item(item, &values, Color::Reset))
+                .collect::<Vec<_>>()
+        };
+        let left = collect(&cfg.left);
+        let right = collect(&cfg.right);
+        let text =
+            |spans: &[Span<'_>]| spans.iter().map(|s| s.content.as_ref()).collect::<String>();
+        for width in 0..120 {
+            let (left, right, right_width) = layout(width, &left, &right, " · ", Color::Reset);
+            assert_eq!(display_width(&text(&right)), usize::from(right_width));
+            assert!(
+                display_width(&text(&left)) + display_width(&text(&right))
+                    <= usize::from(width.saturating_sub(2))
+            );
+        }
+        let (_, spans, _) = layout(100, &left, &right, " · ", Color::Reset);
+        assert_eq!(text(&spans), "astra high · ctx 12%");
+        assert_eq!(
+            spans.iter().find(|s| s.content == "high").unwrap().style.fg,
+            Some(Color::Blue)
+        );
+        let no_model = |field| {
+            if matches!(field, FooterField::Model | FooterField::Effort) {
+                None
+            } else {
+                values(field)
+            }
+        };
+        assert!(render_item(&cfg.right[0], &no_model, Color::Reset).is_none());
+        let missing_effort = |field| {
+            if field == FooterField::Effort {
+                None
+            } else {
+                values(field)
+            }
+        };
+        let group = render_item(&cfg.right[0], &missing_effort, Color::Reset).unwrap();
+        assert_eq!(
+            text(&group.spans),
+            "astra ",
+            "literal spacing is preserved, not reinterpreted as a separator"
+        );
+    }
+    #[test]
+    fn pane_footer_permissions_distinguish_bypass() {
+        let palette = AppState::test_new().palette;
+        let cfg = PaneFooterConfig::default();
+        assert_eq!(access(None, &cfg, &palette), None);
+        for label in ["[workspace]", "[read only]", "[auto]", "[full access]"] {
+            assert_eq!(
+                access(Some(label), &cfg, &palette),
+                Some((label.into(), palette.yellow))
+            );
+        }
+        assert_eq!(
+            access(Some("[bypass]"), &cfg, &palette),
+            Some(("[bypass]".into(), palette.red))
+        );
+    }
+    #[test]
+    fn pane_footer_unknown_metrics_are_not_zero_or_red() {
+        let palette = AppState::test_new().palette;
+        let cfg = PaneFooterConfig::default();
+        assert_eq!(metric("ctx", None, &cfg, &palette), None);
+        assert_eq!(metric("ctx", Some("NaN"), &cfg, &palette), None);
+        for (used, color) in [
+            ("0", palette.green),
+            ("80", palette.green),
+            ("81", palette.yellow),
+            ("95", palette.yellow),
+            ("96", palette.red),
+        ] {
+            assert_eq!(metric("ctx", Some(used), &cfg, &palette).unwrap().1, color);
+        }
+    }
+}

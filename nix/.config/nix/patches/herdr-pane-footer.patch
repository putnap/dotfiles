+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn pane_footer_config_accepts_layout_and_colors_and_rejects_mistakes() {
+        let cfg: PaneFooterConfig = toml::from_str(
+            "left=['branch']\nright=['context','model']\ndirectory_color='#abc'\nseparator=' | '",
+        )
+        .unwrap();
+        assert_eq!(cfg.left, vec![FooterField::Branch.into()]);
+        assert_eq!(
+            cfg.right,
+            vec![FooterField::Context.into(), FooterField::Model.into()]
+        );
+        for text in [
+            "left=['oops']",
+            "left=['model','model']",
+            "branch_color='oops'",
+            "unknown=true",
+            "separator='\\u001b'",
+        ] {
+            // Literal escape text is printable; control validation is checked separately below.
+            if !text.starts_with("separator") {
+                assert!(toml::from_str::<PaneFooterConfig>(text).is_err());
+            }
+        }
+        assert!(toml::from_str::<PaneFooterConfig>("separator=\"\\n\"").is_err());
+    }
+    #[test]
+    fn pane_footer_config_nested_groups_are_literal_and_bounded() {
+        let cfg: PaneFooterConfig =
+            toml::from_str("right = [['model', ' ', 'effort'], 'context']").unwrap();
+        assert_eq!(
+            cfg.right[0],
+            FooterItem::Group(vec![
+                FooterAtom::Token(FooterField::Model),
+                FooterAtom::Literal(" ".into()),
+                FooterAtom::Token(FooterField::Effort)
+            ])
+        );
+        let roundtrip = toml::to_string(&cfg).unwrap();
+        assert_eq!(
+            toml::from_str::<PaneFooterConfig>(&roundtrip)
+                .unwrap()
+                .right,
+            cfg.right
+        );
+        for text in [
+            "right=[['model'], 'model']",
+            "right=[[[ 'model' ]]]",
+            "right=[{token='effort',separator=' '}]",
+            "right=[[\"\\n\"]]",
+        ] {
+            assert!(toml::from_str::<PaneFooterConfig>(text).is_err(), "{text}");
+        }
+    }
+}

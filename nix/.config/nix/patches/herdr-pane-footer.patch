+    pub usage_color: FooterColor,
+    pub warning_color: FooterColor,
+    pub critical_color: FooterColor,
+    pub separator_color: FooterColor,
+    pub background_color: FooterColor,
+}
+impl Default for PaneFooterConfig {
+    fn default() -> Self {
+        use FooterField::*;
+        use FooterPalette as P;
+        Self {
+            enabled: false,
+            left: vec![Access.into(), Directory.into(), Branch.into()],
+            right: vec![
+                FooterItem::Group(vec![
+                    FooterAtom::Token(Model),
+                    FooterAtom::Literal(" ".into()),
+                    FooterAtom::Token(Effort),
+                ]),
+                Context.into(),
+                FiveHour.into(),
+                Weekly.into(),
+            ],
+            separator: " · ".into(),
+            warning_percent: 80,

+use super::sidebar::SidebarTokenColor;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FooterField {
+    Access,
+    Directory,
+    Branch,
+    Model,
+    Effort,
+    Context,
+    FiveHour,
+    Weekly,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum FooterPalette {
+    Red,
+    Green,
+    Yellow,
+    Blue,
+    Mauve,
+    Teal,
+    Peach,
+    Text,
+    Subtext0,
+    Surface0,
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum FooterColor {
+    Palette(FooterPalette),
+    Rgb(SidebarTokenColor),
+}
+impl FooterColor {
+    pub(crate) fn resolve(self, p: &crate::app::state::Palette) -> ratatui::style::Color {
+        match self {
+            Self::Rgb(c) => c.ratatui(),
+            Self::Palette(c) => match c {
+                FooterPalette::Red => p.red,
+                FooterPalette::Green => p.green,
+                FooterPalette::Yellow => p.yellow,
+                FooterPalette::Blue => p.blue,
+                FooterPalette::Mauve => p.mauve,
+                FooterPalette::Teal => p.teal,
+                FooterPalette::Peach => p.peach,
+                FooterPalette::Text => p.text,
+                FooterPalette::Subtext0 => p.subtext0,
+                FooterPalette::Surface0 => p.surface0,
+            },
+        }
+    }
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum FooterAtom {
+    Token(FooterField),
+    Literal(String),
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum FooterItem {
+    Token(FooterField),
+    Group(Vec<FooterAtom>),
+}
+impl From<FooterField> for FooterItem {
+    fn from(field: FooterField) -> Self {
+        Self::Token(field)
+    }
+}
+fn printable(value: &str) -> bool {
+    value.len() <= 32 && !value.chars().any(char::is_control)
+}
+fn fields<'de, D: serde::Deserializer<'de>>(d: D) -> Result<Vec<FooterItem>, D::Error> {
+    let items = Vec::<FooterItem>::deserialize(d)?;
+    if items.len() > 8 {
+        return Err(serde::de::Error::custom(
+            "footer sides allow at most eight items",
+        ));
+    }
+    let mut seen = Vec::new();
+    for item in &items {
+        let mut tokens = Vec::new();
+        match item {
+            FooterItem::Token(field) => tokens.push(*field),
+            FooterItem::Group(atoms) => {
+                if atoms.len() > 16 {
+                    return Err(serde::de::Error::custom(
+                        "footer groups allow at most sixteen elements",
+                    ));
+                }
+                for atom in atoms {
+                    match atom {
+                        FooterAtom::Token(field) => tokens.push(*field),
+                        FooterAtom::Literal(text) if !printable(text) => {
+                            return Err(serde::de::Error::custom(
+                                "footer literals must be printable and at most 32 bytes",
+                            ))
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+        for token in tokens {
+            if seen.contains(&token) {
+                return Err(serde::de::Error::custom(
+                    "footer tokens must be distinct within each side",
+                ));
+            }
+            seen.push(token);
+        }
+    }
+    Ok(items)
+}
+fn separator<'de, D: serde::Deserializer<'de>>(d: D) -> Result<String, D::Error> {
+    let value = String::deserialize(d)?;
+    if value.len() > 32 || value.chars().any(char::is_control) {
+        return Err(serde::de::Error::custom(
+            "footer separator must be printable and at most 32 bytes",
+        ));
+    }
+    Ok(value)
+}
+/// Presentation only: collectors publish values through pane.report_metadata.
+#[derive(Debug, Clone, Deserialize, Serialize)]
+#[serde(default, deny_unknown_fields)]
+pub struct PaneFooterConfig {

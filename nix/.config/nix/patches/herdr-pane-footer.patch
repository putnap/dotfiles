+            branch_color: FooterColor::Palette(P::Blue),
+            model_color: FooterColor::Palette(P::Mauve),
+            effort_color: FooterColor::Palette(P::Mauve),
+            usage_color: FooterColor::Palette(P::Green),
+            warning_color: FooterColor::Palette(P::Yellow),
+            critical_color: FooterColor::Palette(P::Red),
+            separator_color: FooterColor::Palette(P::Text),
+            background_color: FooterColor::Palette(P::Surface0),
+        }

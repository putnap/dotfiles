{
  "claude": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "^Bash$",
          "hooks": [
            {
              "type": "command",
              "command": "/run/current-system/sw/bin/atuin hook claude-code"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "^Bash$",
